{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PeopleSoft DataMover",
  "scopeName": "source.datamover",
  "fileTypes": ["dms", "dmt"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#commands" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#record-names" },
    { "include": "#numbers" },
    { "include": "#set-options" },
    { "include": "#export-import-params" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.rem.datamover",
          "match": "(?i)^\\s*(REM|REMARK)\\b.*$"
        },
        {
          "name": "comment.block.datamover",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": []
        },
        {
          "name": "comment.line.double-slash.datamover",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.datamover",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.datamover",
              "match": "''"
            }
          ]
        },
        {
          "name": "string.quoted.double.datamover",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.datamover",
              "match": "\\\\\""
            }
          ]
        }
      ]
    },

    "commands": {
      "patterns": [
        {
          "name": "keyword.control.command.datamover",
          "match": "(?i)\\b(EXPORT|IMPORT|REPLACE_ALL|REPLACE_DATA|REPLACE_NONE|RENAME|DELETE_ROWS|COPY_FROM_DB|COPY_INTO_DB|ENCRYPT_PASSWORD|SET|SWAP_BASE_LANGUAGE|CLOSE|OPEN|DATABASE_OPEN|CHANGE_ACCESS_PASSWORD|IMPORT_I18N)\\b"
        },
        {
          "name": "keyword.control.flow.datamover",
          "match": "(?i)\\b(IF|ELSE|END-IF|THEN|BEGIN|END|GOTO|LABEL|EXIT|STOP|PAUSE|CALL|RETURN)\\b"
        },
        {
          "name": "keyword.control.run.datamover",
          "match": "(?i)\\b(RUN|RUNSCRIPT|EXECUTE)\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.datamover",
          "match": "(?i)\\b(WHERE|AND|OR|NOT|IN|LIKE|BETWEEN|IS|NULL|ORDER|BY|ASC|DESC|DISTINCT|ALL|AS|ON|FROM|INTO|VALUES|UPDATE|INSERT|SELECT|CREATE|DROP|ALTER|TABLE|INDEX|VIEW|TRIGGER|SEQUENCE|PROCEDURE|FUNCTION|PACKAGE|GRANT|REVOKE|COMMIT|ROLLBACK|SAVEPOINT|TRUNCATE|COMMENT|COLUMN|CONSTRAINT|PRIMARY|KEY|FOREIGN|REFERENCES|UNIQUE|CHECK|DEFAULT|WITH|SET|HAVING|GROUP|JOIN|INNER|LEFT|RIGHT|FULL|OUTER|CROSS|UNION|INTERSECT|MINUS|EXCEPT|CASE|WHEN|THEN|END)\\b"
        },
        {
          "name": "storage.type.datamover",
          "match": "(?i)\\b(CHAR|VARCHAR|VARCHAR2|LONG|NUMBER|INTEGER|INT|SMALLINT|FLOAT|REAL|DATE|TIMESTAMP|CLOB|BLOB|NCHAR|NVARCHAR2|RAW|LONGRAW|ROWID|UROWID|BOOLEAN|BINARY_INTEGER|PLS_INTEGER|NATURAL|POSITIVE|STRING|RECORD|TABLE|TYPE|SUBTYPE|EXCEPTION|CURSOR|REF)\\b"
        },
        {
          "name": "support.function.datamover",
          "match": "(?i)\\b(TO_CHAR|TO_DATE|TO_NUMBER|NVL|NVL2|DECODE|CASE|COALESCE|NULLIF|GREATEST|LEAST|SUBSTR|INSTR|LENGTH|LTRIM|RTRIM|TRIM|UPPER|LOWER|REPLACE|TRANSLATE|LPAD|RPAD|CHR|ASCII|CONCAT|SOUNDEX|ROUND|TRUNC|CEIL|FLOOR|MOD|POWER|SQRT|ABS|SIGN|BITAND|COUNT|SUM|AVG|MAX|MIN|STDDEV|VARIANCE|RANK|DENSE_RANK|ROW_NUMBER|ROWNUM|SYSDATE|SYSTIMESTAMP|CURRENT_DATE|CURRENT_TIMESTAMP|MONTHS_BETWEEN|ADD_MONTHS|NEXT_DAY|LAST_DAY|EXTRACT|SYS_GUID|USERENV|USER|UID|ROWID)\\b"
        }
      ]
    },

    "set-options": {
      "patterns": [
        {
          "name": "support.constant.set-option.datamover",
          "match": "(?i)\\b(SET\\s+)(INPUT|OUTPUT|LOG|UNICODE_ENABLE|UNICODE_DISABLE|NO_RECORD_LOCKING|RECORD_LOCKING|IGNORE_DUPS|COMMIT_ENABLED|COMMIT_DISABLED|STATISTICS|NO_STATISTICS|IGNORE_ERRORS|NO_IGNORE_ERRORS|CREATE_TABLE_ON|CREATE_TABLE_OFF|DBNAME|DBTYPE|DBUSERNAME|DBPASSWORD|ACCESSID|ACCESSPSWD)\\b"
        }
      ]
    },

    "export-import-params": {
      "patterns": [
        {
          "name": "variable.parameter.datamover",
          "match": "(?i)\\b(ENCODE|DECODE|REPLACE|APPEND|VERSION|WHERE_RECORD|BIND_RECNAME|AUDIT_RECNAME|EFFDT_RECNAME|LANGUAGE_CD|BASE_LANGUAGE_CD|NO_TRANSLATE|TRANSLATE)\\b"
        }
      ]
    },

    "record-names": {
      "patterns": [
        {
          "name": "entity.name.type.record.datamover",
          "match": "(?i)\\b(PS_[A-Z0-9_]+)\\b"
        },
        {
          "name": "entity.name.type.peoplecode-record.datamover",
          "match": "(?i)\\b(PSRECDEFN|PSFIELDDEFN|PSRECFIELD|PSDBFIELD|PSDBRECORD|PSMENUDEFN|PSPNLDEFN|PSPNLFIELD|PSPCMPROG|PSAPPCLASSDEFN|PSAPMSGDEFN|PSIBSVCSETUP|PSOPRDEFN|PSROLEDEFN|PSAUTHITEM|PSPERMLIST|PSCLASSDEFN|PSRECDEFNLANG|PSFLDDEFNLANG)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.datamover",
          "match": "(=|<>|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.datamover",
          "match": "(?i)\\b(AND|OR|NOT)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.datamover",
          "match": "(\\+|-|\\*|/|\\|\\|)"
        },
        {
          "name": "punctuation.separator.datamover",
          "match": "[,;]"
        },
        {
          "name": "punctuation.section.parens.datamover",
          "match": "[()]"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.datamover",
          "match": "\\b([0-9]+\\.[0-9]*)([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.datamover",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}
