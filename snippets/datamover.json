{
  "Script Header": {
    "prefix": "header",
    "description": "Standard script header",
    "body": [
      "REM ============================================================",
      "REM  Script      : ${1:script_name}.dms",
      "REM  Environment : ${2:ENV}",
      "REM  Author      : ${3:Your Name}",
      "REM  Date        : ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "REM  Description : ${4:Describe what this script does}",
      "REM ============================================================",
      "",
      "SET LOG ${5:c:\\temp\\}${1}.log;",
      "",
      "$0"
    ]
  },
  "Set Input/Output/Log": {
    "prefix": "set-io",
    "description": "SET INPUT, OUTPUT and LOG together",
    "body": [
      "SET INPUT  ${1:c:\\temp\\}${2:data}.dat;",
      "SET OUTPUT ${1}${2}.dat;",
      "SET LOG    ${1}${2}.log;",
      "$0"
    ]
  },
  "Export Record": {
    "prefix": "export",
    "description": "EXPORT a record",
    "body": ["EXPORT ${1:PS_RECORD_NAME};"]
  },
  "Export with WHERE": {
    "prefix": "export-where",
    "description": "EXPORT with WHERE clause",
    "body": ["EXPORT ${1:PS_RECORD_NAME} WHERE ${2:FIELD} = '${3:value}';"]
  },
  "Import Record": {
    "prefix": "import",
    "description": "IMPORT a record",
    "body": ["IMPORT ${1:PS_RECORD_NAME};"]
  },
  "Replace All": { "prefix": "replace-all",  "body": ["REPLACE_ALL ${1:PS_RECORD_NAME};"] },
  "Replace Data": { "prefix": "replace-data", "body": ["REPLACE_DATA ${1:PS_RECORD_NAME};"] },
  "Replace None": { "prefix": "replace-none", "body": ["REPLACE_NONE ${1:PS_RECORD_NAME};"] },
  "Delete Rows": { "prefix": "delete-rows",   "body": ["DELETE_ROWS ${1:PS_RECORD_NAME};"] },
  "Delete Rows WHERE": {
    "prefix": "delete-rows-where",
    "body": ["DELETE_ROWS ${1:PS_RECORD_NAME} WHERE ${2:FIELD} = '${3:value}';"]
  },
  "IF Block": {
    "prefix": "if",
    "body": ["IF ${1:condition}", "   ${2:EXPORT PS_RECORD_NAME;}", "END-IF", "$0"]
  },
  "IF ELSE Block": {
    "prefix": "if-else",
    "body": ["IF ${1:condition}", "   ${2:statement;}", "ELSE", "   ${3:statement;}", "END-IF", "$0"]
  },
  "IF Oracle": { "prefix": "if-oracle", "body": ["IF #DBTYPE = \"ORACLE\"", "   ${1:EXPORT PS_RECORD_NAME;}", "END-IF", "$0"] },
  "IF MSSQL":  { "prefix": "if-mssql",  "body": ["IF #DBTYPE = \"MICROSFT\"", "   ${1:EXPORT PS_RECORD_NAME;}", "END-IF", "$0"] },
  "IF DB2":    { "prefix": "if-db2",    "body": ["IF #DBTYPE = \"DB2UNIX\"",  "   ${1:EXPORT PS_RECORD_NAME;}", "END-IF", "$0"] },
  "Full Export Block": {
    "prefix": "export-block",
    "body": [
      "REM --- Export ${1:description} ---",
      "SET OUTPUT ${2:c:\\temp\\}${3:export}.dat;",
      "SET LOG    ${2}${3}.log;",
      "",
      "EXPORT ${4:PS_RECORD_NAME};",
      "$0",
      "",
      "STOP;"
    ]
  },
  "Full Import Block": {
    "prefix": "import-block",
    "body": [
      "REM --- Import ${1:description} ---",
      "SET INPUT ${2:c:\\temp\\}${3:export}.dat;",
      "SET LOG   ${2}${3}_import.log;",
      "",
      "REPLACE_${4|ALL,DATA,NONE|} ${5:PS_RECORD_NAME};",
      "$0",
      "",
      "STOP;"
    ]
  },
  "Export PeopleTools": {
    "prefix": "export-tools",
    "body": ["REM --- PeopleTools ---","EXPORT PSRECDEFN;","EXPORT PSFIELDDEFN;","EXPORT PSRECFIELD;","EXPORT PSDBFIELD;","EXPORT PSDBRECORD;","$0"]
  },
  "Export Security": {
    "prefix": "export-security",
    "body": ["REM --- Security ---","EXPORT PSOPRDEFN;","EXPORT PSROLEDEFN;","EXPORT PSROLEUSER;","EXPORT PSAUTHITEM;","EXPORT PSPERMLIST;","$0"]
  },
  "Export PeopleCode": {
    "prefix": "export-peoplecode",
    "body": ["REM --- PeopleCode ---","EXPORT PSPCMPROG;","EXPORT PSPCMTXT;","$0"]
  },
  "REM Divider": {
    "prefix": "rem-section",
    "body": ["REM -----------------------------------------------------------","REM ${1:Section Title}","REM -----------------------------------------------------------","$0"]
  },
  "Block Comment": { "prefix": "block-comment", "body": ["/*"," * ${1:Comment}", " */","$0"] },
  "Stop":           { "prefix": "stop",          "body": ["STOP;"] },
  "Encrypt Password": { "prefix": "encrypt-password", "body": ["ENCRYPT_PASSWORD ${1:password};"] },
  "Set No Locking": { "prefix": "no-locking", "body": ["SET NO_RECORD_LOCKING;"] },
  "Set Ignore Dups": { "prefix": "ignore-dups", "body": ["SET IGNORE_DUPS;"] },
  "Unicode On":  { "prefix": "unicode-on",  "body": ["SET UNICODE_ENABLE;"] },
  "Unicode Off": { "prefix": "unicode-off", "body": ["SET UNICODE_DISABLE;"] }
}
