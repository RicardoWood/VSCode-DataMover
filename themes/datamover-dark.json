{
  "name": "DataMover Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0d1117",
    "editor.foreground": "#c9d1d9",
    "editorLineNumber.foreground": "#484f58",
    "editorLineNumber.activeForeground": "#79c0ff",
    "editor.selectionBackground": "#264f78",
    "editor.lineHighlightBackground": "#161b22",
    "editorCursor.foreground": "#58a6ff",
    "editorError.foreground": "#f85149",
    "editorWarning.foreground": "#d29922"
  },
  "tokenColors": [
    { "scope": ["comment.line.rem.datamover","comment.block.datamover","comment.line.double-slash.datamover"], "settings": { "foreground": "#6e7681", "fontStyle": "italic" } },
    { "scope": ["string.quoted.single.datamover","string.quoted.double.datamover"],                           "settings": { "foreground": "#a5d6ff" } },
    { "scope": "constant.character.escape.datamover",                                                         "settings": { "foreground": "#ffa657" } },
    { "scope": ["keyword.control.command.datamover","keyword.control.flow.datamover"],                        "settings": { "foreground": "#ff7b72", "fontStyle": "bold" } },
    { "scope": "keyword.control.set.datamover",                                                               "settings": { "foreground": "#ffa657", "fontStyle": "bold" } },
    { "scope": "keyword.control.run.datamover",                                                               "settings": { "foreground": "#d2a8ff", "fontStyle": "bold" } },
    { "scope": "keyword.other.datamover",                                                                     "settings": { "foreground": "#79c0ff" } },
    { "scope": "storage.type.datamover",                                                                      "settings": { "foreground": "#7ee787" } },
    { "scope": "support.function.datamover",                                                                  "settings": { "foreground": "#d2a8ff" } },
    { "scope": "support.constant.set-option.datamover",                                                       "settings": { "foreground": "#ffa657" } },
    { "scope": "variable.parameter.datamover",                                                                "settings": { "foreground": "#e3b341" } },
    { "scope": "variable.language.datamover",                                                                 "settings": { "foreground": "#79c0ff", "fontStyle": "italic" } },
    { "scope": "entity.name.type.record.datamover",                                                           "settings": { "foreground": "#7ee787", "fontStyle": "italic" } },
    { "scope": "entity.name.type.peoplecode-record.datamover",                                                "settings": { "foreground": "#56d364", "fontStyle": "bold italic" } },
    { "scope": ["keyword.operator.comparison.datamover","keyword.operator.arithmetic.datamover"],             "settings": { "foreground": "#ff7b72" } },
    { "scope": ["punctuation.separator.datamover","punctuation.section.parens.datamover"],                    "settings": { "foreground": "#8b949e" } },
    { "scope": ["constant.numeric.float.datamover","constant.numeric.integer.datamover"],                     "settings": { "foreground": "#79c0ff" } }
  ]
}
